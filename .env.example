# Copy this file to `.env` (never commit `.env` itself) and fill in real
# values before running `docker compose up -d`. See docs/environment-variables.md.

# Bootstraps the first administrator account on first startup. Only takes
# effect while no admin account exists yet — see docs/first-admin.md.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-real-password

# ---------------------------------------------------------------------------
# Transport security
# ---------------------------------------------------------------------------
# Adds `Secure` to the session cookie, so browsers only ever send it back
# over HTTPS. Docker Compose runs the backend with NODE_ENV=production, and
# a production backend REFUSES TO START unless this is exactly "true" —
# there is no way to serve a session cookie over plain HTTP by accident.
# Only "true" and "false" are accepted; "TRUE", "1" or "yes" are errors.
COOKIE_SECURE=true

# Public hostname Traefik routes to this dashboard.
DASHBOARD_HOST=dashboard.avalonnova.com

# Traefik entrypoint names, as defined in YOUR Traefik static configuration.
# The HTTP entrypoint is only used to redirect to HTTPS.
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web

# Name of the entry under `certificatesResolvers` in your Traefik static
# configuration. VERIFY THIS against your own Traefik setup before
# deploying — a resolver name that doesn't exist means no certificate, and
# with `Secure` cookies that means nobody can log in.
TRAEFIK_CERT_RESOLVER=letsencrypt

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Session lifetime (see specs/003-auth-persistence/spec.md's Clarifications).
SESSION_IDLE_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90

# Max POST /auth/login attempts per IP per minute. The default guards against
# brute force; raise it only for automated suites hitting one address.
LOGIN_RATE_LIMIT_MAX=20
